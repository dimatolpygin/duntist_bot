# Реальный файл .env.second хранится только на сервере, chmod 600.
# Все значения здесь записываются БЕЗ кавычек: compose читает format: raw.
# Для подключения останется заполнить только эти два значения:
BOT_TOKEN=
GROUP_ID=

# При подготовке копируются с первого экземпляра; не публиковать реальные значения.
ADMIN_IDS=
DATABASE_URL=postgresql://postgres:change_me@postgres:5432/postgres
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
LOG_LEVEL=INFO

# BOT_VARIANT=second, DB_SCHEMA=zarub_second, REDIS_URL=redis://redis:6379/1
# и S3_KEY_PREFIX=orders-second закреплены в docker-compose.second.yml.
